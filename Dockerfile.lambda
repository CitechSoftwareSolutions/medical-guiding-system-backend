# AWS Lambda Container Image for MedGuidance Backend
FROM public.ecr.aws/lambda/python:3.11

# AWS Lambda task directory
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy and install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code and database migrations
COPY app/ ./app/
COPY alembic.ini .
COPY alembic/ ./alembic/

# Environment variable default to prevent auto-seed cold start slowdowns
ENV AUTO_SEED_ON_STARTUP=false

# AWS Lambda handler entrypoint: <module>.<function>
CMD ["app.main.handler"]
