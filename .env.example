# ===================================================================
# Database Connection (PostgreSQL / AWS Aurora Serverless)
# ===================================================================
# Local development:
DATABASE_URL=postgresql+psycopg://postgres:pgadmin1234@localhost:5432/medical_guidance_db
# Cloud / AWS RDS example:
# DATABASE_URL=postgresql+psycopg://dbuser:StrongPassword@medguidance-db.cluster-xyz.us-east-1.rds.amazonaws.com:5432/medguidance

# ===================================================================
# JWT & Security
# ===================================================================
SECRET_KEY=medical-guidance-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===================================================================
# Storage Backend Configuration
# ===================================================================
# Set STORAGE_BACKEND to 'auto', 'local', or 's3'.
# When 'auto', S3 is used if S3_BUCKET_NAME is provided, otherwise falls back to local.
STORAGE_BACKEND=auto
UPLOAD_DIR=uploads

# AWS S3 Settings (Required for Serverless / Cloud Deployments)
# S3_BUCKET_NAME=medguidance-uploads-prod
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_CUSTOM_DOMAIN=cdn.medguidance.com  # Optional CloudFront CDN domain

# ===================================================================
# Serverless Runtime Configuration
# ===================================================================
# In local development, keep True to automatically seed default roles & admin.
# In AWS Lambda serverless deployments, set to False to eliminate cold-start latency.
AUTO_SEED_ON_STARTUP=true
