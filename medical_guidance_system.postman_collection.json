              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor.smith@hospital.org\",\n  \"password\": \"DoctorPass123!\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Smith\",\n  \"phone\": \"+1234567890\",\n  \"role\": \"Doctor\"\n}"
